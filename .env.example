# Pooled connection (host contains "-pooler") - used by the app at runtime
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Direct connection - used by drizzle-kit migrations only
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Signs session cookies (min 32 chars, e.g. 'openssl rand -base64 32')
SESSION_SECRET=
# Optional: share the session across subdomains in production
COOKIE_DOMAIN=.squadbase.nl

# Email Configuration: Zoho Mail (SMTP)
SMTP_HOST=smtppro.zoho.eu
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Squadbase <login@squadbase.nl>

