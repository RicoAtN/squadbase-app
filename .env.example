# Pooled connection (host contains "-pooler") - used by the app at runtime
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Direct connection - used by drizzle-kit migrations only
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Signs session cookies (min 32 chars, e.g. 'openssl rand -base64 32')
SESSION_SECRET=
# Optional: share the session across subdomains in production
COOKIE_DOMAIN=.squadbase.nl

# Email: Zoho Mail (SMTP). Use a Zoho App Password, not your normal password.
# EU accounts: smtppro.zoho.eu (or smtp.zoho.eu). Other regions: smtp.zoho.com.
SMTP_HOST=smtppro.zoho.eu
SMTP_PORT=465
SMTP_USER=login@squadbase.nl
SMTP_PASS=
# Must be the SMTP_USER address or an alias of it, otherwise Zoho rejects the mail.
MAIL_FROM=Squadbase <login@squadbase.nl>

# Local development ONLY: show the login link on screen instead of needing a mailbox.
# Ignored in production.
ALLOW_DEV_LOGIN_LINK=false

